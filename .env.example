# ---- App ----
APP_NAME=chatdash
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ---- Database ----
DB_HOST=db
DB_PORT=5432
DB_NAME=chatdash
DB_USER=chatdash
DB_PASSWORD=chatdash
DATABASE_URL=postgresql+asyncpg://chatdash:chatdash@db:5432/chatdash

# ---- Bale connector ----
# Set to "real" to attempt live Bale calls, "mock" for local dev.
BALE_CONNECTOR_MODE=mock
# Base URL for the Bale client API (pluggable adapter).
BALE_BASE_URL=https://api.bale.com
# Session credentials obtained from the Bale app.
BALE_SESSION_ID=
BALE_USER_ID=
# Optional request timeout in seconds.
BALE_REQUEST_TIMEOUT=30
# Simple rate-limit: minimum seconds between outbound requests.
BALE_RATE_LIMIT_SECONDS=1

# ---- Sync ----
SYNC_INTERVAL_SECONDS=300
SYNC_BATCH_SIZE=100
# Max messages to backfill per conversation on initial sync.
SYNC_INITIAL_DEPTH=50
# Hard cap on messages fetched per incremental batch.
SYNC_MAX_MESSAGE_BATCH=200

# ---- Redis / worker (optional, future) ----
REDIS_URL=redis://redis:6379/0